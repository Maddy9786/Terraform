# Provider
provider "aws" {
  region = "us-east-1"

}

# key pair creation
resource "aws_key_pair" "deployer" {
  key_name    = "terra_automate_key"
  public_key = file("terra_automate_key.pub")
}


# default vpc
resource "aws_default_vpc" "default" {
}

# security group
resource "aws_security_group" "terra_sec_group" {
  description = "Allow TLS inbound traffic and all outbound traffic"
  vpc_id      = aws_default_vpc.default.id
}

# Ingress Rule
resource "aws_vpc_security_group_ingress_rule" "allow_http_ipv4" {
  security_group_id = aws_security_group.terra_sec_group.id
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = 80
  ip_protocol       = "TCP"
  to_port           = 80
}

resource "aws_vpc_security_group_ingress_rule" "allow_tls_ipv4" {
  security_group_id = aws_security_group.terra_sec_group.id
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = 22
  ip_protocol       = "TCP"
  to_port           = 22
}


# Egress Rule
resource "aws_vpc_security_group_egress_rule" "allow_all_traffic_ipv4" {
  security_group_id = aws_security_group.terra_sec_group.id
  cidr_ipv4         = "0.0.0.0/0"
  ip_protocol       = "-1" # semantically equivalent to all ports
}


#  Instance Creation
resource "aws_instance" "ec2_instance" {

  count = 2

  ami = "ami-091138d0f0d41ff90"

  instance_type = "t3.micro"

  vpc_security_group_ids = [aws_security_group.terra_sec_group.id]

  key_name = aws_key_pair.deployer.key_name


  # Resource block (ebs)
  root_block_device {
    volume_size = 10
    volume_type = "gp3"
  }

  # instance_name
  tags = {
    Name = "terra_automate_server"
  }

}

